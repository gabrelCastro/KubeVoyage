# Public domain. Its DNS must point to this server; Caddy gets the HTTPS certificate.
DOMAIN=kubelearn.example.com

# Long and random, e.g.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Outgoing mail for sign-in links (Resend, SES, Mailgun, Postmark, ...). STARTTLS is required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KubeLearn <no-reply@kubelearn.example.com>

# Optional: GitHub sign-in. Callback URL: https://$DOMAIN/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Only when the site is not served on 80/443 (e.g. a local test):
# HTTP_PORT=8080
# HTTPS_PORT=8443
# PUBLIC_URL=https://localhost:8443
